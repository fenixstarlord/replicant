# systemd unit for replicant-server on the home server.
# Install: sudo cp replicant-server /usr/local/bin/ && sudo cp replicant-server.service /etc/systemd/system/
#          sudo mkdir -p /var/lib/replicant && sudo useradd -r -s /usr/sbin/nologin replicant && sudo chown replicant /var/lib/replicant
#          sudo systemctl daemon-reload && sudo systemctl enable --now replicant-server
[Unit]
Description=Replicant drive catalog server
After=network-online.target
Wants=network-online.target

[Service]
User=replicant
Group=replicant
ExecStart=/usr/local/bin/replicant-server
Restart=on-failure
RestartSec=3
# Bind to the NetBird or LAN address only; never a public interface.
Environment=REPLICANT_LISTEN=0.0.0.0:8080
Environment=REPLICANT_DATA_DIR=/var/lib/replicant
# Set the password in an env file not readable by others:
#   echo 'REPLICANT_PASSWORD=change-me' | sudo tee /etc/replicant.env && sudo chmod 600 /etc/replicant.env
EnvironmentFile=/etc/replicant.env
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/replicant
PrivateTmp=true

[Install]
WantedBy=multi-user.target
