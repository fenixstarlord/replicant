# Copy to .env next to docker-compose.yml.
SHELF_PASSWORD=change-me
# Address Macs use to reach the server, e.g. the host's NetBird IP.
SHELF_PUBLIC_URL=http://100.64.0.5:8080
SHELF_PORT=8080
# Host paths. On TrueNAS SCALE use dataset paths, e.g. /mnt/pool/apps/shelf.
SHELF_DATA=./data
SHELF_MEDIA=./media
TZ=America/Los_Angeles
# Image tag to run (latest, or a release like v0.1.0).
SHELF_TAG=latest
